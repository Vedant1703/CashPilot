# ==============================================================================
# CashPilot AI — Environment Configuration Template
# ==============================================================================
# IMPORTANT: Never commit actual secrets or production credentials to git.
# Copy this file to `.env` or `.env.local` for local development.

# Server & Application
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# PayPal Sandbox API (Server-side ONLY — Never expose to client)
# Obtain credentials from https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here

# AI Inference Provider (Server-side ONLY)
# Supported adapters: Google Gemini, Anthropic, OpenAI
AI_PROVIDER=gemini
AI_API_KEY=your_ai_api_key_here
AI_MODEL=gemini-1.5-pro

# Database Configuration
# Relational database connection string (e.g., SQLite or PostgreSQL)
DATABASE_URL=file:./dev.db

# Security & Session
SESSION_SECRET=replace_with_a_secure_random_string_in_local_env
