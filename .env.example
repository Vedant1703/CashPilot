# ==============================================================================
# CashPilot AI — Local Development Configuration
# ==============================================================================
# Copy this to .env.local for local development. NEVER commit actual secrets.

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Database (PostgreSQL via Prisma) ─────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://vedantkulkarni@localhost:5432/cashpilot_dev"

# ── PayPal Sandbox (server-side ONLY, never expose to browser) ───────────────
# Obtain from: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
# Sandbox base URL (do not change for sandbox)
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# ── AI Inference (server-side ONLY) ─────────────────────────────────────────
# Supported: google/gemini, anthropic, openai
AI_PROVIDER=google
AI_API_KEY=your_ai_api_key_here
AI_MODEL=gemini-1.5-pro

# ── Security / Session ───────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace_with_64_hex_chars_generated_by_openssl_rand_hex_32

# ── Workspace (Demo) ─────────────────────────────────────────────────────────
# ID of the demo workspace seeded by db:seed
DEMO_WORKSPACE_ID=demo-workspace-1
